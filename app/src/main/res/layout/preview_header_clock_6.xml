<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="start|center"
    android:orientation="horizontal">

    <ImageView
        android:tag="profile_picture"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="4dp"
        android:adjustViewBounds="true"
        android:clickable="false"
        android:clipToOutline="true"
        android:scaleType="fitCenter"
        android:src="@drawable/default_avatar" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    <FrameLayout
         android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="start|center"
         android:layout_gravity="start|center"
         android:tag="clock"
        android:layoutDirection="Itr"
         android:layout_marginStart="18dp">
        
        <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:singleLine="true"
                android:tag="text1"
              android:layout_gravity="start|center"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="?android:textColorPrimary"
                android:textSize="38dp"
                android:textStyle="bold" />           
 <TextClock
           
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="60dp"
                android:singleLine="true"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
     android:maxLength="2"
                android:includeFontPadding="false"
       android:layout_gravity="start|center"
                android:textColor="#FFCD2D31"
                android:textSize="18dp"
                android:textStyle="bold" />

         <TextClock
           
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
             android:layout_marginEnd="3dp"
                android:singleLine="true"
            android:format12Hour="aa"
             android:textAllCaps="true"
            android:format24Hour="aa"
                android:includeFontPadding="false"
               android:layout_gravity="start|end"
                android:textColor="#FFCD2D31"
                android:textSize="18dp"
                android:textStyle="bold" />
        
    </FrameLayout>
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
            <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/time_container_background_accent"
        android:gravity="center_horizontal"
        android:tag="gradient"
        >

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center"
            android:layout_margin="2dp"
             android:background="@drawable/container_background_accent"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:singleLine="true"
            android:tag="clock"
            android:textColor="@color/white"
            android:textSize="12dp"
            android:textStyle="bold" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:format12Hour="dd, MMM"
            android:format24Hour="dd, MMM"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:singleLine="true"
            android:tag="date"
            android:textColor="@color/white"
            android:textSize="12dp" />
 <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center"
            android:layout_margin="2dp"
             android:background="@drawable/container_background_accent"
            android:format12Hour="yyy"
            android:format24Hour="yyy"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:singleLine="true"
            android:tag="clock"
            android:textColor="@color/white"
            android:textSize="12dp"
            android:textStyle="bold" />
    </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
